{
    "version": 2,
    "framework": null,
    "builds": [
        {
            "src": "server.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(build|assets|images|storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.(?:ico|svg|png)|robots\\.txt)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/server.php"
        }
    ]
}
